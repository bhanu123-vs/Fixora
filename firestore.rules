rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity test endpoint
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Bootstrapped Admin: Bhanu (verified user email) or database role == 'admin'
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'bhanuvenkatanagesh@gmail.com' && request.auth.token.email_verified == true) ||
        (hasUserDoc() && userDoc().role == 'admin')
      );
    }

    function isWarden() {
      return isSignedIn() && (
        isAdmin() ||
        (hasUserDoc() && userDoc().role == 'warden')
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (hasUserDoc() && userDoc().role == 'maintenance_staff')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isWarden();
      
      // Allow self-registration as student/warden/staff, admin reserved for bootstrapped email or admin
      allow create: if (
        isOwner(userId) && (
          request.resource.data.role in ['student', 'warden', 'maintenance_staff'] ||
          (request.auth.token.email == 'bhanuvenkatanagesh@gmail.com' && request.auth.token.email_verified == true)
        )
      ) || isAdmin();

      // Users can update their personal profile info, but NOT their role, uid, or email
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email'])
      );

      allow delete: if isAdmin();
    }

    // COMPLAINTS COLLECTION
    match /complaints/{complaintId} {
      // Individual document get
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        (isWarden() && (resource.data.assignedWardenUid == request.auth.uid || (hasUserDoc() && resource.data.building == userDoc().assignedHostel))) ||
        (isStaff() && resource.data.assignedStaffUid == request.auth.uid)
      );

      // List queries: evaluated against client where clause
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentUid == request.auth.uid ||
        (isWarden() && (resource.data.assignedWardenUid == request.auth.uid || (hasUserDoc() && resource.data.building == userDoc().assignedHostel))) ||
        (isStaff() && resource.data.assignedStaffUid == request.auth.uid)
      );

      // Authenticated students can submit complaints, admins can create any
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.studentUid == request.auth.uid
      );

      // Updates:
      // - Admins and Wardens can update assignments, status, priority, and notes
      // - Maintenance staff can update status and resolution notes
      // - Students can confirm resolution, rate, reopen, and append timeline audit entry
      allow update: if isAdmin() || isWarden() ||
        (isStaff() && resource.data.assignedStaffUid == request.auth.uid) ||
        (isSignedIn() && resource.data.studentUid == request.auth.uid &&
          request.resource.data.studentUid == resource.data.studentUid &&
          request.resource.data.status in ['Resolved', 'Reopened'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'resolutionConfirmedByStudent',
            'studentRating',
            'studentFeedback',
            'reopenedReason',
            'timeline',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin();

      // STATUS HISTORY SUBCOLLECTION
      match /statusHistory/{historyId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          get(/databases/$(database)/documents/complaints/$(complaintId)).data.studentUid == request.auth.uid ||
          isWarden() ||
          (isStaff() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.assignedStaffUid == request.auth.uid)
        );
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource.data.recipientUid == request.auth.uid ||
        resource.data.recipientRole == 'all' ||
        (isWarden() && resource.data.recipientRole == 'warden') ||
        (isStaff() && resource.data.recipientRole == 'maintenance_staff')
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.recipientUid == request.auth.uid ||
        resource.data.recipientRole == 'all'
      );

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'title', 'message', 'timestamp', 'isRead']);

      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.recipientUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
      );

      allow delete: if isAdmin();
    }

    // HOSTELS DIRECTORY COLLECTION
    match /hostels/{hostelId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
